{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		},
		"strict": true,
		"noImplicitAny": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true
	}
}
