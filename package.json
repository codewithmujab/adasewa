{
	"name": "adasewa",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:local": "docker compose up -d",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:seed": "node scripts/seed.ts",
		"db:studio": "drizzle-kit studio",
		"cf-typegen": "wrangler types",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.2.1",
		"better-auth": "^1.7.27",
		"drizzle-orm": "^0.45.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261123.1",
		"@sveltejs/adapter-cloudflare": "^9.0.0",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"dotenv": "^18.0.10",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"wrangler": "^4.166.0"
	}
}
