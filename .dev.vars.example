# Environment variables lokal untuk SvelteKit + Cloudflare Workers ($app/env/private)
# Untuk Neon Cloud, hapus NEON_FETCH_ENDPOINT dan isi DATABASE_URL dengan connection string Neon Anda.
DATABASE_URL="postgresql://adasewa:adasewa_local_password@127.0.0.1:5440/adasewa"
NEON_FETCH_ENDPOINT="http://127.0.0.1:4445/sql"
BETTER_AUTH_SECRET="ganti-dengan-minimal-32-karakter-acak-yang-aman"
BETTER_AUTH_URL="http://localhost:5173"
ALLOW_ADMIN_SIGNUP="true"
R2_PUBLIC_URL=""
